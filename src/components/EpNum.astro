---
interface Props { n: string; size?: 'sm' | 'md' | 'lg' | 'xl'; class?: string }
const { n, size = 'md', class: cls = '' } = Astro.props;
const sizes = {
  sm: 'h-8 w-8 text-[11px]',
  md: 'h-11 w-11 text-[13px]',
  lg: 'h-16 w-16 text-lg',
  xl: 'h-24 w-24 text-2xl',
};
---
<span class={`epnum ${sizes[size]} ${cls}`} aria-hidden="true"><span>{n}</span></span>
