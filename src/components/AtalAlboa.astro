---
/**
 * Atalaren gaien zerrenda, alboan (pantaila handietan bakarrik).
 * Ikasten ari zarenean, atal bereko gaien artean salto egiteko.
 */
import type { Atala } from '../data/gida';

interface Props {
  atala: Atala;
  oraingoa: string;
}

const { atala, oraingoa } = Astro.props;
const elementuak = atala.mota === 'gaiak' ? atala.gaiak : atala.kasuak;
---

<nav aria-label={`${atala.laburra}: gaiak`} class="sticky top-24">
  <p class="etiketa text-rojo">
    <a href={`/${atala.id}/`} class="hover:text-rojovivo">{atala.laburra}</a>
  </p>
  <p class="mb-4 mt-1 text-[0.95rem] text-piedra">{atala.izenburua}</p>
  <ol class="space-y-0.5 border-l border-white/10">
    {
      elementuak.map((g) => {
        const oraingoaDa = g.slug === oraingoa;
        return (
          <li>
            <a
              href={`/${atala.id}/${g.slug}/`}
              aria-current={oraingoaDa ? 'page' : undefined}
              class:list={[
                '-ml-px block border-l-2 py-1.5 pl-4 text-[0.98rem] leading-snug transition-colors',
                oraingoaDa ? 'border-rojo text-hueso' : 'border-transparent text-piedra hover:text-hueso',
              ]}
            >
              {g.izena}
            </a>
          </li>
        );
      })
    }
  </ol>
</nav>
