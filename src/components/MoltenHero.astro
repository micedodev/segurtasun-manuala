---
// Fondo "metal fundido" para el hero: vetas rojas fluyendo sobre negro.
// Canvas 2D propio, sin dependencias. Muy tenue por defecto; el negro manda.
// Respeta prefers-reduced-motion (un solo frame estático) y solo anima
// cuando el hero está visible.
---
<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <canvas id="molten" class="h-full w-full"></canvas>
</div>
<script>
  const canvas = document.getElementById('molten');
  if (canvas && canvas.getContext) {
    const ctx = canvas.getContext('2d');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const parent = canvas.parentElement;
    let w = 0;
    let h = 0;
    let raf = 0;
    const DPR = Math.min(1.5, window.devicePixelRatio || 1);

    function size() {
      if (!parent) return;
      const r = parent.getBoundingClientRect();
      w = Math.max(1, r.width);
      h = Math.max(1, r.height);
      canvas.width = Math.floor(w * DPR);
      canvas.height = Math.floor(h * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      if (reduce) draw(1200);
    }

    // Cinco vetas que cruzan el hero; cada una con su fase y velocidad.
    // core = alfa del núcleo, glow = alfa del halo.
    const veins = [
      { y: 0.16, amp: 44, sp: 0.00016, ph: 0.0, core: 0.32, glow: 0.065 },
      { y: 0.34, amp: 58, sp: 0.00011, ph: 2.1, core: 0.22, glow: 0.045 },
      { y: 0.52, amp: 50, sp: 0.00013, ph: 4.2, core: 0.26, glow: 0.05 },
      { y: 0.7, amp: 38, sp: 0.00009, ph: 1.2, core: 0.18, glow: 0.04 },
      { y: 0.86, amp: 54, sp: 0.00014, ph: 5.3, core: 0.2, glow: 0.04 },
    ];

    const embers = Array.from({ length: 24 }, () => ({
      x: Math.random(),
      y: Math.random(),
      s: 0.6 + Math.random() * 1.3,
      v: 0.5 + Math.random() * 1.2,
      ph: Math.random() * 6.28,
    }));

    const travelers = [
      { vein: 0, v: 0.000028, off: 0.1 },
      { vein: 2, v: 0.000019, off: 0.6 },
    ];

    function veinY(v, x, t) {
      return (
        v.y * h +
        Math.sin(x * 0.004 + t * v.sp * 6 + v.ph) * v.amp +
        Math.sin(x * 0.011 - t * v.sp * 9 + v.ph * 2) * v.amp * 0.35
      );
    }

    function strokeVein(v, t, width, style) {
      ctx.beginPath();
      for (let x = -40; x <= w + 40; x += 12) {
        const y = veinY(v, x, t);
        if (x === -40) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = style;
      ctx.lineWidth = width;
      ctx.lineCap = 'round';
      ctx.stroke();
    }

    function draw(t) {
      ctx.clearRect(0, 0, w, h);
      // Respiración general: halo tenue arriba-derecha.
      const g = ctx.createRadialGradient(
        w * 0.85, h * 0.08, 0,
        w * 0.85, h * 0.08, Math.max(w, h) * 0.7
      );
      const breathe = 0.025 + 0.01 * Math.sin(t * 0.0004);
      g.addColorStop(0, `rgba(217,72,72,${breathe.toFixed(3)})`);
      g.addColorStop(1, 'rgba(217,72,72,0)');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, w, h);

      veins.forEach((v) => {
        strokeVein(v, t, 7, `rgba(140,26,26,${v.glow})`);
        strokeVein(v, t, 2.4, `rgba(217,72,72,${v.core})`);
        strokeVein(v, t, 1.1, `rgba(255,107,107,${(v.core * 0.55).toFixed(3)})`);
      });

      // Viajeros: puntos de brasa que recorren dos vetas.
      travelers.forEach((tr) => {
        const v = veins[tr.vein];
        const x = ((t * tr.v + tr.off) % 1.2) * (w + 80) - 40;
        const y = veinY(v, x, t);
        ctx.beginPath();
        ctx.arc(x, y, 5, 0, 6.2832);
        ctx.fillStyle = 'rgba(217,72,72,0.09)';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(x, y, 1.7, 0, 6.2832);
        ctx.fillStyle = 'rgba(255,140,140,0.6)';
        ctx.fill();
      });

      // Ascuas ascendiendo, casi invisibles.
      embers.forEach((e) => {
        const y = (e.y - ((t * 0.000008 * e.v) % 1.2) + 1.2) % 1;
        const tw = 0.16 + 0.13 * Math.sin(t * 0.001 + e.ph);
        ctx.beginPath();
        ctx.arc(e.x * w, y * h, e.s, 0, 6.2832);
        ctx.fillStyle = `rgba(217,72,72,${Math.max(0, tw).toFixed(3)})`;
        ctx.fill();
      });
    }

    function loop(t) {
      if (document.hidden) {
        raf = requestAnimationFrame(loop);
        return;
      }
      draw(t || 0);
      raf = requestAnimationFrame(loop);
    }

    function start() {
      if (running()) return;
      size();
      if (reduce) return;
      raf = requestAnimationFrame(loop);
    }
    function running() {
      return raf !== 0;
    }
    function stop() {
      cancelAnimationFrame(raf);
      raf = 0;
    }

    size();
    if (reduce) {
      draw(1200);
    } else {
      start();
      if ('IntersectionObserver' in window && parent) {
        new IntersectionObserver((es) => {
          es.forEach((e) => {
            if (e.isIntersecting) start();
            else stop();
          });
        }).observe(parent);
      }
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) start();
      });
    }
    window.addEventListener('resize', size);
    window.addEventListener('orientationchange', size);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(size);
    if ('ResizeObserver' in window && parent) new ResizeObserver(size).observe(parent);
  }
</script>
<style>
  #molten {
    -webkit-mask-image: radial-gradient(130% 100% at 70% 0%, black 30%, transparent 80%);
    mask-image: radial-gradient(130% 100% at 70% 0%, black 30%, transparent 80%);
  }
</style>
