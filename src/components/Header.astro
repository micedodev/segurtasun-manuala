---
import { T, otherLang, type Lang } from '../lib/i18n';
interface Props { lang: Lang; active?: string }
const { lang, active = '' } = Astro.props;
const t = T[lang];
const o = otherLang(lang);
const nav = [
  { slug: 'ud1', n: '01', label: lang === 'es' ? 'Introducción' : 'Sarrera' },
  { slug: 'ud2', n: '02', label: lang === 'es' ? 'Lógica' : 'Logikoa' },
  { slug: 'ud3', n: '03', label: lang === 'es' ? 'Activa' : 'Aktiboa' },
  { slug: 'ciberataques', n: '04', label: lang === 'es' ? 'Ciberataques' : 'Zibererasoak' },
  { slug: 'perimetral', n: '05', label: lang === 'es' ? 'Perimetral' : 'Perimetrala' },
  { slug: 'glosario', n: 'G', label: t.glosario },
];
function href(slug: string) { return `/${lang}/${slug}`; }
function swapHref() {
  const path = Astro.url.pathname;
  if (path.startsWith('/es/') || path.startsWith('/eu/')) return `/${o}${path.slice(3)}`;
  if (path === '/es' || path === '/eu' || path === '/') return `/${o}`;
  return `/${o}`;
}
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-carbon-950/85 backdrop-blur-md">
  <div class="mx-auto flex h-[60px] max-w-[1280px] items-center gap-3 px-4 md:px-8">
    <a href={`/${lang}`} class="flex items-center gap-3">
      <span class="grid h-8 w-8 place-items-center rounded-[4px] border border-white/20 bg-carbon-800">
        <svg width="18" height="18" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 5l9 4.5V16c0 5.6-3.9 9.2-9 11-5.1-1.8-9-5.4-9-11V9.5z" stroke="#ECE9E2" stroke-width="2"/><circle cx="16" cy="16" r="3" fill="#D94848"/></svg>
      </span>
      <span class="flex flex-col justify-center">
        <span class="font-display text-[15px] font-medium leading-[1.3] tracking-tight text-hueso">SegurtasunManuala</span>
        <span class="font-mono mt-[1px] block text-[9px] font-medium uppercase leading-[1.5] tracking-[0.24em] text-piedra">{t.manual} · {lang.toUpperCase()}</span>
      </span>
    </a>
    <nav class="ml-8 hidden items-center gap-6 lg:flex" aria-label={t.nav_principal}>
      {nav.map((n) => (
        <a href={href(n.slug)} aria-current={active === n.slug ? 'page' : undefined} class={`font-mono text-[11px] font-medium uppercase tracking-[0.18em] transition ${active === n.slug ? 'text-hueso underline decoration-rojo decoration-2 underline-offset-8' : 'text-piedra hover:text-hueso'}`}><span class="mr-1 text-humo" aria-hidden="true">{n.n}</span>{n.label}</a>
      ))}
    </nav>
    <a
      href={swapHref()}
      hreflang={o === 'es' ? 'es-ES' : 'eu-ES'}
      aria-label={t.cambiar_idioma}
      class="ml-auto inline-flex items-center gap-1.5 rounded-[2px] border border-white/20 px-3 py-1.5 font-mono text-[11px] font-medium text-hueso transition hover:border-rojo hover:text-rojo"
    >
      <span aria-hidden="true" class={lang === 'es' ? 'text-hueso' : 'text-humo'}>ES</span>
      <span aria-hidden="true" class="text-humo">/</span>
      <span aria-hidden="true" class={lang === 'eu' ? 'text-hueso' : 'text-humo'}>EU</span>
    </a>
  </div>
  <div class="lg:hidden overflow-x-auto border-t border-white/10">
    <nav class="flex gap-5 px-4 py-2" aria-label={t.nav_secciones}>
      {nav.map((n) => (
        <a href={href(n.slug)} aria-current={active === n.slug ? 'page' : undefined} class={`whitespace-nowrap font-mono text-[11px] font-medium uppercase tracking-[0.16em] ${active === n.slug ? 'text-hueso underline decoration-rojo decoration-2 underline-offset-4' : 'text-piedra'}`}><span class="mr-1 text-humo" aria-hidden="true">{n.n}</span>{n.label}</a>
      ))}
    </nav>
  </div>
</header>
