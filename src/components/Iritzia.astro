---
/** Egilearen iritzia: lehen pertsonan, laburra, gai bakoitzaren amaieran. */
interface Props {
  iritzia: string[];
}

const { iritzia } = Astro.props;
---

<section class="mt-12 rounded-md bg-leun px-5 py-6 md:px-7" aria-labelledby="iritzia">
  <h2 id="iritzia" class="text-[1.5rem] font-extrabold tracking-tight md:text-[1.65rem]">Nire iritzia</h2>
  <div class="mt-3 space-y-3">
    {iritzia.map((p) => <p>{p}</p>)}
  </div>
  <p class="mt-4 text-[0.95rem] font-semibold text-lauso">Markel</p>
</section>
