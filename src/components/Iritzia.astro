---
/** Egilearen iritzia: lehen pertsonan, laburra, gai bakoitzaren amaieran. */
interface Props {
  iritzia: string[];
}

const { iritzia } = Astro.props;
---

<section class="velo mt-14 rounded-[3px] px-5 py-6 md:px-7" aria-labelledby="iritzia">
  <h2 id="iritzia" class="text-[1.6rem] font-light tracking-tight md:text-[1.85rem]">Nire iritzia</h2>
  <div class="mt-3 space-y-3 text-hueso/90">
    {iritzia.map((p) => <p>{p}</p>)}
  </div>
  <p class="etiketa mt-5 text-piedra">— Markel</p>
</section>
