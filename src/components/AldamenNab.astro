---
/** Aurreko eta hurrengo gaia, gida osoan zehar (atalen artean ere bai). */
import { aldamenak } from '../data/gida';

interface Props {
  href: string;
}

const { aurrekoa, hurrengoa } = aldamenak(Astro.props.href);
---

<nav aria-label="Gaien artean nabigatu" class="mt-16 grid gap-3 border-t border-marra pt-6 sm:grid-cols-2">
  {
    aurrekoa ? (
      <a href={aurrekoa.href} rel="prev" class="group rounded-md border border-marra px-5 py-4 hover:border-tinta">
        <span class="block text-[0.95rem] text-lauso">
          <span aria-hidden="true">← </span>Aurrekoa
        </span>
        <span class="block font-bold group-hover:underline">{aurrekoa.izena}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    hurrengoa && (
      <a
        href={hurrengoa.href}
        rel="next"
        class="group rounded-md border border-marra px-5 py-4 text-right hover:border-tinta"
      >
        <span class="block text-[0.95rem] text-lauso">
          Hurrengoa<span aria-hidden="true"> →</span>
        </span>
        <span class="block font-bold group-hover:underline">{hurrengoa.izena}</span>
      </a>
    )
  }
</nav>
