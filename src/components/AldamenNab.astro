---
/** Aurreko eta hurrengo gaia, gida osoan zehar (atalen artean ere bai). */
import { aldamenak } from '../data/gida';

interface Props {
  href: string;
}

const { aurrekoa, hurrengoa } = aldamenak(Astro.props.href);
---

<nav aria-label="Gaien artean nabigatu" class="mt-16 grid gap-3 border-t border-white/10 pt-6 sm:grid-cols-2">
  {
    aurrekoa ? (
      <a
        href={aurrekoa.href}
        rel="prev"
        class="group rounded-[3px] border border-white/15 px-5 py-4 transition-colors hover:border-rojo"
      >
        <span class="etiketa block text-piedra">
          <span aria-hidden="true" class="text-rojo">← </span>Aurrekoa
        </span>
        <span class="mt-1 block text-[1.15rem] transition-colors group-hover:text-rojovivo">{aurrekoa.izena}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    hurrengoa && (
      <a
        href={hurrengoa.href}
        rel="next"
        class="group rounded-[3px] border border-white/15 px-5 py-4 text-right transition-colors hover:border-rojo"
      >
        <span class="etiketa block text-piedra">
          Hurrengoa<span aria-hidden="true" class="text-rojo"> →</span>
        </span>
        <span class="mt-1 block text-[1.15rem] transition-colors group-hover:text-rojovivo">{hurrengoa.izena}</span>
      </a>
    )
  }
</nav>
