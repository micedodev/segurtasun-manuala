---
import Base from '../../layouts/Base.astro';
import AtalAlboa from '../../components/AtalAlboa.astro';
import AldamenNab from '../../components/AldamenNab.astro';
import EraginTaula from '../../components/EraginTaula.astro';
import Iritzia from '../../components/Iritzia.astro';
import { lortuEragina } from '../../data/eragina';
import { ATALAK, type Atala, type Gaia, type Kasua } from '../../data/gida';

export function getStaticPaths() {
  return ATALAK.flatMap((atala) => {
    const elementuak: (Gaia | Kasua)[] = atala.mota === 'gaiak' ? atala.gaiak : atala.kasuak;
    return elementuak.map((elementua) => ({
      params: { atala: atala.id, slug: elementua.slug },
      props: { atala, elementua },
    }));
  });
}

interface Props {
  atala: Atala;
  elementua: Gaia | Kasua;
}

const { atala, elementua } = Astro.props;
const href = `/${atala.id}/${elementua.slug}/`;
const gaia = atala.mota === 'gaiak' ? (elementua as Gaia) : null;
const kasua = atala.mota === 'kasuak' ? (elementua as Kasua) : null;
// Orri bakoitzak bere eragina eta iritzia izan behar ditu; bestela eraikitzeak huts egiten du.
const { eragina, iritzia } = lortuEragina(atala.id, elementua.slug);

const h2 = 'text-[1.6rem] font-light tracking-tight md:text-[1.85rem]';
const atala2 = 'mt-14';
---

<Base izenburua={elementua.izena} deskribapena={elementua.laburpena} atala={atala.id}>
  <div class="mx-auto max-w-6xl px-5 md:px-8 lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
    <aside class="hidden pt-[5.25rem] lg:block">
      <AtalAlboa atala={atala} oraingoa={elementua.slug} />
    </aside>

    <article class="min-w-0 max-w-testua">
      <nav aria-label="Ogi-apurrak" class="etiketa pt-8 text-piedra">
        <a href="/" class="hover:text-hueso">Hasiera</a>
        <span aria-hidden="true" class="mx-2 text-rojo">/</span>
        <a href={`/${atala.id}/`} class="hover:text-hueso">
          {atala.mota === 'gaiak' ? `${atala.laburra}: ${atala.izenburua}` : atala.izenburua}
        </a>
      </nav>

      <header class="mt-7 border-l-2 border-rojo pl-5 md:pl-7">
        <p class="etiketa text-rojo">
          {elementua.etiketa}{kasua && ` · ${kasua.urtea}`}
        </p>
        <h1 class="mt-3 break-words text-[clamp(2.75rem,9vw,5.25rem)] font-light leading-[0.98] tracking-[-0.02em]">
          {elementua.izena}{!elementua.izena.endsWith(')') && <span class="text-rojo">.</span>}
        </h1>
        <p class="mt-5 text-[1.2rem] leading-relaxed text-piedra md:text-[1.3rem]">{elementua.laburpena}</p>
      </header>

      {
        gaia && (
          <>
            <section class={atala2} aria-labelledby="zer-den">
              <h2 id="zer-den" class={h2}>Zer den</h2>
              <p class="mt-3">{gaia.zerDen}</p>
            </section>

            <section class={atala2} aria-labelledby="nola">
              <h2 id="nola" class={h2}>Nola funtzionatzen du</h2>
              <ol class="urratsak mt-5 space-y-5">
                {gaia.urratsak.map((u) => (
                  <li>{u}</li>
                ))}
              </ol>
            </section>

            <section class={atala2} aria-labelledby="adibidea">
              <h2 id="adibidea" class={h2}>Adibidea</h2>
              <figure class="velo mt-5 rounded-[3px] px-5 py-6 md:px-7">
                <p class="etiketa text-rojo">◉ Benetako kasua · {gaia.adibidea.urtea}</p>
                <h3 class="mt-2 text-[1.3rem] font-normal leading-snug tracking-tight">{gaia.adibidea.izenburua}</h3>
                <p class="mt-2 text-hueso/90">{gaia.adibidea.testua}</p>
                <figcaption class="mt-4 text-[0.95rem] text-piedra">
                  Iturria:{' '}
                  <a href={gaia.adibidea.iturria.url} class="esteka text-hueso" rel="noopener">
                    {gaia.adibidea.iturria.izena}
                  </a>
                </figcaption>
              </figure>
            </section>

            <EraginTaula eragina={eragina} />

            <section class={atala2} aria-labelledby="babestu">
              <h2 id="babestu" class={h2}>Nola babestu</h2>
              <ul class="babesa mt-4 space-y-3">
                {gaia.babesa.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </section>

            <aside class="mt-14 border-y border-white/10 py-6" aria-labelledby="gogoratu">
              <h2 id="gogoratu" class="etiketa text-rojo">Gogoratu</h2>
              <p class="mt-2 text-[1.4rem] font-light leading-snug md:text-[1.6rem]">{gaia.gogoratu}</p>
            </aside>

            <Iritzia iritzia={iritzia} />
          </>
        )
      }

      {
        kasua && (
          <>
            <section class={atala2} aria-labelledby="gertatua">
              <h2 id="gertatua" class={h2}>Zer gertatu zen</h2>
              <div class="mt-3 space-y-4">
                {kasua.gertatua.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </section>

            <section class={atala2} aria-labelledby="nola">
              <h2 id="nola" class={h2}>Nola egin zuten</h2>
              <ol class="urratsak mt-5 space-y-5">
                {kasua.urratsak.map((u) => (
                  <li>{u}</li>
                ))}
              </ol>
            </section>

            <section class={atala2} aria-labelledby="ezaugarriak">
              <h2 id="ezaugarriak" class={h2}>Erasoaren ezaugarriak</h2>
              <dl class="mt-4 divide-y divide-white/10 border-y border-white/10">
                {kasua.ezaugarriak.map((e) => (
                  <div class="grid gap-1 py-3 sm:grid-cols-[11rem_1fr] sm:gap-6">
                    <dt class="etiketa pt-1 text-piedra">{e.izena}</dt>
                    <dd>{e.balioa}</dd>
                  </div>
                ))}
              </dl>
            </section>

            <EraginTaula eragina={eragina} />

            <section class={atala2} aria-labelledby="ondorioak">
              <h2 id="ondorioak" class={h2}>Zergatik da garrantzitsua</h2>
              <ul class="babesa mt-4 space-y-3">
                {kasua.ondorioak.map((o) => (
                  <li>{o}</li>
                ))}
              </ul>
            </section>

            <Iritzia iritzia={iritzia} />

            <section class={atala2} aria-labelledby="iturriak">
              <h2 id="iturriak" class={h2}>Iturriak</h2>
              <ul class="mt-4 space-y-2">
                {kasua.iturriak.map((i) => (
                  <li>
                    <a href={i.url} class="esteka" rel="noopener">
                      {i.izena}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          </>
        )
      }

      <AldamenNab href={href} />
    </article>
  </div>
</Base>
