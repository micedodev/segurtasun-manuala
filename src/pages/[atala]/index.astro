---
import Base from '../../layouts/Base.astro';
import GaiZerrenda from '../../components/GaiZerrenda.astro';
import { ATALAK, type Atala } from '../../data/gida';

export function getStaticPaths() {
  return ATALAK.map((atala) => ({ params: { atala: atala.id }, props: { atala } }));
}

interface Props {
  atala: Atala;
}

const { atala } = Astro.props;
const izenburua = atala.mota === 'gaiak' ? `${atala.laburra}: ${atala.izenburua}` : atala.izenburua;
const zenbakia = String(ATALAK.indexOf(atala) + 1).padStart(2, '0');
---

<Base izenburua={izenburua} deskribapena={atala.sarrera} atala={atala.id}>
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <nav aria-label="Ogi-apurrak" class="etiketa pt-8 text-piedra">
      <a href="/" class="hover:text-hueso">Hasiera</a>
      <span aria-hidden="true" class="mx-2 text-rojo">/</span>
      <span aria-current="page" class="text-hueso">{atala.laburra}</span>
    </nav>

    <header class="mt-8 flex items-start gap-5 md:gap-7">
      <span class="epnum mt-1 h-11 w-11 text-[0.85rem] text-rojo md:h-20 md:w-20 md:text-[1.35rem]" aria-hidden="true">
        {zenbakia}
      </span>
      <div class="min-w-0">
        {atala.mota === 'gaiak' && <p class="etiketa text-rojo">{atala.laburra}</p>}
        <h1 class="mt-1 break-words text-[clamp(1.9rem,8vw,4.5rem)] font-extralight uppercase leading-[0.98] tracking-tight">
          {atala.izenburua}
        </h1>
        <p class="mt-5 max-w-testua text-[1.2rem] leading-relaxed text-piedra md:text-[1.3rem]">{atala.sarrera}</p>
      </div>
    </header>

    <div class="mt-12 border-t border-white/10">
      <GaiZerrenda atala={atala} />
    </div>
  </div>
</Base>
