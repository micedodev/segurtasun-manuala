---
import Base from '../layouts/Base.astro';
import GaiZerrenda from '../components/GaiZerrenda.astro';
import { ATALAK, ORRIAK, GAI_KOPURUA } from '../data/gida';

const lehena = ORRIAK[0];
const kasuak = ATALAK.find((a) => a.mota === 'kasuak');
const kasuKopurua = kasuak && kasuak.mota === 'kasuak' ? kasuak.kasuak.length : 0;
---

<Base
  izenburua="Mehatxu informatikoen gida"
  deskribapena="Segurtasun informatikoko mehatxuak euskaraz: zer diren, nola funtzionatzen duten, benetako adibide bat eta nola babestu."
>
  <section class="mx-auto max-w-6xl px-5 pb-6 pt-12 md:px-8 md:pt-20">
    <h1 class="max-w-[14ch] text-[clamp(2.6rem,7vw,4.75rem)] font-extrabold leading-[1.02] tracking-[-0.025em]">
      Mehatxu informatikoen gida
    </h1>
    <p class="mt-6 max-w-testua text-[1.25rem] leading-relaxed text-lauso md:text-[1.375rem]">
      {GAI_KOPURUA} mehatxu eta {kasuKopurua} eraso erreal, modu argian azalduta. Gai bakoitzean: zer den, nola
      funtzionatzen duen, benetako adibide bat eta nola babestu.
    </p>
    {
      lehena && (
        <a
          href={lehena.href}
          class="mt-8 inline-block rounded-md bg-tinta px-6 py-3 text-[1.05rem] font-bold text-white hover:bg-black"
        >
          Hasi lehen gaiarekin: {lehena.izena}
        </a>
      )
    }
  </section>

  {
    ATALAK.map((atala) => (
      <section
        id={atala.id}
        aria-labelledby={`${atala.id}-izenburua`}
        class="mx-auto max-w-6xl scroll-mt-6 px-5 pt-14 md:px-8"
        style={`--atal: ${atala.kolorea}`}
      >
        <div class="mb-6 flex items-start gap-4">
          <span class="atal-hondoa mt-2 h-8 w-2 shrink-0 rounded-sm" aria-hidden="true" />
          <div>
            <h2 id={`${atala.id}-izenburua`} class="text-[1.75rem] font-extrabold leading-tight tracking-tight">
              <a href={`/${atala.id}/`} class="hover:underline">
                {atala.mota === 'gaiak' ? `${atala.laburra}: ${atala.izenburua}` : atala.izenburua}
              </a>
            </h2>
            <p class="mt-1 max-w-testua text-lauso">{atala.sarrera}</p>
          </div>
        </div>
        <GaiZerrenda atala={atala} />
      </section>
    ))
  }
</Base>
