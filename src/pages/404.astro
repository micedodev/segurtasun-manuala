---
import Base from '../layouts/Base.astro';
import { ATALAK, atalaHref } from '../data/gida';
---

<Base izenburua="Orria ez da aurkitu" deskribapena="Bilatzen ari zaren orria ez dago gida honetan.">
  <div class="mx-auto max-w-6xl px-5 pt-16 md:px-8">
    <p class="etiketa text-rojo">● 404</p>
    <h1 class="mt-3 text-[clamp(2.4rem,6.5vw,4.5rem)] font-extralight uppercase leading-[0.98] tracking-tight">
      Orri hau ez dago<span class="text-rojo">.</span>
    </h1>
    <p class="mt-5 max-w-testua text-[1.2rem] leading-relaxed text-piedra">
      Helbidea aldatu egin da edo gaizki idatzita dago. Aukeratu atal bat edo itzuli hasierara.
    </p>
    <ul class="mt-8 flex flex-wrap gap-3">
      <li>
        <a href="/" class="btn-rojo">Hasiera</a>
      </li>
      {
        ATALAK.map((a) => (
          <li>
            <a href={atalaHref(a.id)} class="btn-line">
              {a.laburra}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
