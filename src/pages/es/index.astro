---
import Base from '../../layouts/Base.astro';
import EpNum from '../../components/EpNum.astro';
import { T, type Lang } from '../../lib/i18n';
import { CAPITULOS } from '../../lib/content';
const lang: Lang = 'es';
const t = T[lang];
const caps = CAPITULOS[lang];
const ep = ['01', '02', '03', '04', '05'];
---
<Base lang={lang} title="SegurtasunManuala — Manual de Seguridad y Alta Disponibilidad (ES)" description="Web-documental de Seguridad: amenazas, seguridad lógica y activa, ciberataques reales y perímetro." active="">
  <!-- PORTADA -->
  <section class="relative overflow-hidden border-b border-white/10">
    <div data-parallax="0.1" class="hatch pointer-events-none absolute inset-0 opacity-70"></div>
    <div data-parallax="0.16" class="pointer-events-none absolute -right-32 -top-32 h-[480px] w-[480px] rounded-full bg-rojo/10 blur-3xl"></div>
    <div class="relative mx-auto max-w-[1280px] px-4 pb-12 pt-12 md:px-8 md:pt-20">
      <div class="reveal flex flex-wrap items-center gap-2">
        <span class="chip border-rojo/60 text-rojo">● {t.manual}</span>
        <span class="chip border-white/20 text-piedra">ES / EU</span>
        <span class="chip border-white/20 text-piedra">17 fichas · 4 controles · 2 casos</span>
      </div>
      <h1 id="hero-title" class="reveal font-display mt-6 max-w-5xl text-[12vw] font-extralight uppercase leading-[0.95] tracking-tight text-hueso md:text-[96px]">
        Seguridad<br />que se <span id="hero-key" class="pencil-u font-light italic normal-case text-hueso">toca</span><br />con los dedos<span class="text-rojo">.</span>
      </h1>
      <div class="mt-8 grid gap-6 md:grid-cols-[1.2fr_0.8fr] md:items-end">
        <p class="reveal max-w-2xl text-[16px] font-light leading-relaxed text-piedra md:text-lg">
          Un web-documental de <strong class="font-medium text-hueso">Seguridad y Alta Disponibilidad</strong>: phishing, botnets, ransomware, rootkits, VPN, DMZ… Cinco episodios, cada amenaza una ficha de archivo con su tabla CIA, su caso y su defensa.
        </p>
        <div class="reveal flex flex-wrap gap-3">
          <a href={`/${lang}/ud1`} class="btn-rojo">{t.leer} <span aria-hidden="true">→</span></a>
          <a href={`/${lang}/glosario`} class="btn-line">{t.glosario}</a>
        </div>
      </div>
      <script>
        import { scrambleIn, scrambleHover } from '../../scripts/scramble.ts';
        const h1 = document.getElementById('hero-title');
        if (h1) setTimeout(() => scrambleIn(h1, 1200), 400);
        const key = document.getElementById('hero-key');
        if (key) scrambleHover(key, 500);
      </script>
      <div class="reveal mt-10 grid grid-cols-2 border-y border-hueso/20 md:grid-cols-4">
        {[['08', 'amenazas · ❶'], ['05', 'técnicas · ❷'], ['04', 'malware · ❸'], ['02', 'casos · ❹']].map(([n, l], i) => (
          <div class={`px-5 py-5 ${i > 0 ? 'border-l border-hueso/15' : ''} ${i >= 2 ? 'max-md:border-t max-md:border-hueso/15' : ''} ${i === 2 ? 'max-md:border-l-0' : ''}`}>
            <p class="font-display text-5xl font-thin tabular-nums text-hueso">{n}</p>
            <p class="font-mono mt-1 text-[10px] font-medium uppercase tracking-[0.22em] text-piedra">{l}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="relative overflow-hidden border-t border-white/10 py-2.5" aria-hidden="true">
      <div class="marquee-track flex w-max gap-0 whitespace-nowrap font-mono text-[11px] font-medium uppercase tracking-[0.24em] text-humo">
        {[0,1].map(() => <span>Phishing <span class="mx-4 text-rojo">/</span> MITM <span class="mx-4 text-rojo">/</span> Troyano <span class="mx-4 text-rojo">/</span> Backdoor <span class="mx-4 text-rojo">/</span> Spyware <span class="mx-4 text-rojo">/</span> Stealer <span class="mx-4 text-rojo">/</span> Ransomware <span class="mx-4 text-rojo">/</span> Exploit <span class="mx-4 text-rojo">/</span> Botnet <span class="mx-4 text-rojo">/</span> DDoS <span class="mx-4 text-rojo">/</span> Rootkit <span class="mx-4 text-rojo">/</span> RAT <span class="mx-4 text-rojo">/</span> VPN <span class="mx-4 text-rojo">/</span> DMZ <span class="mx-4 text-rojo">/</span> Proxy <span class="mx-4 text-rojo">/</span> Firewall <span class="mx-4 text-rojo">/</span>&nbsp;</span>)}
      </div>
    </div>
  </section>

  <!-- ÍNDICE DE EPISODIOS -->
  <section class="mx-auto max-w-[1280px] px-4 py-12 md:px-8 md:py-16">
    <div class="reveal flex items-end justify-between border-b border-white/10 pb-4">
      <h2 class="font-display text-4xl font-extralight uppercase tracking-tight text-hueso md:text-6xl">{t.indice}</h2>
      <p class="font-mono text-[11px] font-medium uppercase tracking-[0.24em] text-humo">05 + {t.glosario}</p>
    </div>
    <div>
      {caps.map((c, i) => (
        <a href={`/${lang}/${c.slug}`} class="reveal group grid grid-cols-[auto_1fr_auto] items-center gap-4 border-b border-white/10 px-1 py-6 transition md:gap-6 md:px-2" style={`transition-delay:${i * 60}ms`}>
          <span class="text-rojo transition group-hover:text-rojovivo"><EpNum n={ep[i]} size="lg" /></span>
          <span class="min-w-0">
            <span class="etiqueta text-humo">{i < 3 ? `Episodio 0${i+1}` : i === 3 ? 'Casos' : 'Perimetral'}</span>
            <span class="font-display block truncate text-2xl font-light tracking-tight text-hueso md:text-4xl">{c.titulo}</span>
            <span class="block truncate text-sm font-light italic text-piedra">“{c.lema}”</span>
          </span>
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-rojo/70 text-lg text-rojo transition group-hover:translate-x-1 group-hover:bg-rojo group-hover:text-carbon-950" aria-hidden="true">→</span>
        </a>
      ))}
      <a href={`/${lang}/glosario`} class="reveal group grid grid-cols-[auto_1fr_auto] items-center gap-4 px-1 py-6 md:gap-6 md:px-2" style="transition-delay:300ms">
        <span class="text-piedra transition group-hover:text-rojo"><EpNum n="G" size="lg" /></span>
        <span class="min-w-0">
          <span class="etiqueta text-humo">Archivo</span>
          <span class="font-display block text-2xl font-light tracking-tight text-hueso md:text-4xl">{t.glosario} ES–EU</span>
          <span class="block text-sm font-light italic text-piedra">Todos los términos, buscables al instante</span>
        </span>
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-rojo/70 text-lg text-rojo transition group-hover:translate-x-1 group-hover:bg-rojo group-hover:text-carbon-950" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
