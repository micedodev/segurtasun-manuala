---
import Base from '../../layouts/Base.astro';
import { T } from '../../lib/i18n';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
const lang = 'es' as const;
const t = T[lang];
const md = readFileSync(join(process.cwd(), 'contenidos', 'es', 'glosario.md'), 'utf-8');
const rows = md.split('\n').map((l) => l.trim()).filter((l) => l.startsWith('| **')).map((l) => {
  const m = l.split('|').map((s) => s.trim());
  return { term: m[1]?.replace(/\*\*/g, '') ?? '', eu: m[2] ?? '', sec: m[3] ?? '', def: m[4] ?? '' };
});
---
<Base lang={lang} title="Glosario ES–EU — SegurtasunManuala" description="Todos los términos del manual, buscables." active="glosario">
  <section class="mx-auto max-w-[1024px] px-4 py-10 md:px-8 md:py-14">
    <p class="etiqueta text-rojo">Archivo · G</p>
    <h1 class="font-display mt-2 text-4xl font-light tracking-tight text-hueso md:text-6xl">{t.glosario} ES–EU</h1>
    <p class="mt-2 max-w-2xl text-[15px] font-light leading-relaxed text-piedra">Todos los términos del manual. Escribe para filtrar al instante, en cualquiera de los dos idiomas.</p>
    <div class="sticky top-[104px] z-30 mt-6 border border-white/10 bg-carbon-900/95 p-3 backdrop-blur-md md:top-[64px]">
      <input id="q" type="search" placeholder={t.busca_glosario} class="w-full rounded-[2px] border border-white/15 bg-carbon-800 px-4 py-3 text-[15px] font-light text-hueso placeholder:text-humo focus:border-rojo focus:outline-none" />
      <p class="font-mono mt-2 text-[10px] font-medium uppercase tracking-[0.2em] text-humo"><span id="count" class="text-rojo">{rows.length}</span> términos</p>
    </div>
    <div id="grid" class="mt-4 grid gap-px bg-white/10">
      {rows.map((r) => (
        <article class="gcard bg-carbon-900 p-4 transition hover:bg-carbon-800 hover:shadow-[inset_3px_0_0_#D94848]" data-hay={`${r.term} ${r.eu} ${r.def} ${r.sec}`.toLowerCase()}>
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h2 class="font-display text-lg font-normal tracking-tight text-hueso">{r.term}</h2>
            <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-rojo">{r.eu}</span>
          </div>
          <p class="font-mono mt-1 text-[10px] font-medium uppercase tracking-[0.2em] text-humo">{r.sec}</p>
          <p class="mt-1 text-sm font-light leading-relaxed text-piedra">{r.def}</p>
        </article>
      ))}
    </div>
    <div class="mt-8 flex gap-2">
      <a href={`/${lang}/perimetral`} class="btn-line !px-4 !py-2 !text-[11px]">← {t.anterior}</a>
      <a href={`/${lang}`} class="btn-rojo !px-4 !py-2 !text-[11px]">{t.volver_indice}</a>
    </div>
  </section>
  <script>
    const q = document.getElementById('q');
    const cards = [...document.querySelectorAll('.gcard')];
    const count = document.getElementById('count');
    q?.addEventListener('input', () => {
      const v = q.value.toLowerCase().trim();
      let n = 0;
      cards.forEach((c) => {
        const ok = !v || c.getAttribute('data-hay').includes(v);
        c.style.display = ok ? '' : 'none';
        if (ok) n++;
      });
      count.textContent = n;
    });
  </script>
</Base>
