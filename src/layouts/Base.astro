---
import '../styles/global.css';
import { ATALAK, atalaHref, type AtalId } from '../data/gida';

interface Props {
  izenburua: string;
  deskribapena: string;
  /** Orri honen atala: nabigazioan markatzeko eta kolorea emateko. */
  atala?: AtalId;
}

const { izenburua, deskribapena, atala } = Astro.props;
const kolorea = ATALAK.find((a) => a.id === atala)?.kolorea ?? '#17201D';
const osoa = izenburua === 'Mehatxu informatikoen gida' ? izenburua : `${izenburua} | Mehatxu informatikoen gida`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="eu" style={`--atal: ${kolorea}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{osoa}</title>
    <meta name="description" content={deskribapena} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="eu_ES" />
    <meta property="og:site_name" content="Mehatxu informatikoen gida" />
    <meta property="og:title" content={osoa} />
    <meta property="og:description" content={deskribapena} />
    <meta property="og:url" content={canonical.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400..800;1,400..800&display=swap"
    />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#edukia"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-tinta focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
    >
      Jauzi edukira
    </a>

    <header class="border-b border-marra">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-3 px-5 py-4 md:px-8">
        <a href="/" class="group leading-tight">
          <span class="block text-lg font-extrabold tracking-tight group-hover:underline">Mehatxu informatikoen gida</span>
          <span class="block text-[0.9rem] text-lauso">Segurtasuna eta Erabilgarritasun Handia</span>
        </a>
        <nav aria-label="Atalak">
          <ul class="flex flex-wrap gap-x-5 gap-y-1 text-[1rem] font-semibold">
            {
              ATALAK.map((a) => (
                <li>
                  <a
                    href={atalaHref(a.id)}
                    aria-current={a.id === atala ? 'page' : undefined}
                    class:list={[
                      'inline-block border-b-[3px] py-1 transition-colors',
                      a.id === atala ? '' : 'border-transparent text-lauso hover:text-tinta',
                    ]}
                    style={a.id === atala ? `border-color: ${a.kolorea}` : undefined}
                  >
                    {a.laburra}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="edukia" class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 border-t border-marra bg-leun">
      <div class="mx-auto grid max-w-6xl gap-4 px-5 py-8 text-[0.95rem] text-lauso md:grid-cols-[1fr_auto] md:px-8">
        <div>
          <p class="font-semibold text-tinta">Egilea: Markel Icedo</p>
          <p>Segurtasuna eta Erabilgarritasun Handia modulurako lana.</p>
        </div>
        <p class="md:text-right">
          Adibide guztiak benetako kasuak dira.<br />
          <a href="/iturriak/" class="esteka text-tinta">Ikusi iturriak</a>
        </p>
      </div>
    </footer>
  </body>
</html>
